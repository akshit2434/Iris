# Shared private access gate. Keep this server-only.
IRIS_APP_PIN=change-me

# Personal labels are stored in the private Supabase database, never in Git.

# Supabase server connection. The service role key must never be exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter server connection. The model slug is optional.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Optional: a separate low-cost model for one first-turn chat-title request.
# Defaults to OPENROUTER_MODEL when omitted.
# OPENROUTER_TITLE_MODEL=openai/gpt-5.6-luna

# Durable memory consolidation is off by default. The worker route requires
# this server-only secret even when enabled.
# MEMORY_CONSOLIDATION_ENABLED=false
# MEMORY_WORKER_SECRET=change-me
# MEMORY_SEMANTIC_INDEXING_ENABLED=false
# MEMORY_CONTINUITY_ENABLED=false

# Accountability check-ins are swept lazily after each chat turn. Set to true to disable.
# ACCOUNTABILITY_SWEEP_DISABLED=false

# Optional development tracing. Keep disabled unless a private tracing project is configured.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-server-only-langsmith-key
# LANGCHAIN_PROJECT=iris-development

# Tavily web search (server-only). Get a key at tavily.com
TAVILY_API_KEY=your-server-only-tavily-key
